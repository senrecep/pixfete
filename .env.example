# ─────────────────────────────────────────────────────────────────────────────
# Infrastructure / security — the ONLY values read from the environment.
# Everything else (event, storage, upload limits, features) is managed from the
# admin panel: /admin/settings
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ──────────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:3000
API_URL=http://localhost:3001
WEB_PORT=3000
API_PORT=3001
# Browser origin allowed by CORS. Also sent as the `Origin` header when the API
# initiates Google Drive resumable upload sessions, so Drive returns CORS headers
# for the browser's direct upload. In production set this to the real site URL
# (e.g. https://photos.example.com) — must match where the web app is served.
CORS_ORIGIN=http://localhost:3000

# ─── Admin Auth ───────────────────────────────────────────────────────────────
# Generate with: bun -e "import b from 'bcryptjs'; console.log(await b.hash('yourpassword', 12))"
ADMIN_PASSWORD_HASH=\$2b\$12\$placeholder_replace_me

# Random 64-char hex: openssl rand -hex 32
JWT_SECRET=replace_with_random_secret

# Master key used to encrypt stored secrets (R2/GDrive credentials) at rest.
# Random 64-char hex: openssl rand -hex 32. Falls back to JWT_SECRET if unset.
SETTINGS_ENCRYPTION_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=./data/pixfete.db

# ─── Web (Next.js build-time) ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL first-boot seed. If set, these seed the admin settings the FIRST time
# the database is created; afterwards they are ignored — manage from /admin/settings.
#
# Storage:  STORAGE_PROVIDER=local|r2|gdrive · STORAGE_BASE_PATH · UPLOADS_DIR
#           CLOUDFLARE_R2_ENDPOINT · CLOUDFLARE_R2_ACCESS_KEY · CLOUDFLARE_R2_SECRET_KEY
#           CLOUDFLARE_R2_BUCKET · CLOUDFLARE_R2_PUBLIC_URL
#           GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON · GOOGLE_DRIVE_FOLDER_ID
# Upload:   UPLOAD_MAX_FILE_SIZE_MB · UPLOAD_MAX_FILES_PER_SESSION · RATE_LIMIT_UPLOADS_PER_HOUR
# Event:    EVENT_TITLE · EVENT_SUBTITLE · EVENT_DATE · EVENT_VENUE_NAME · EVENT_VENUE_ADDRESS
#           EVENT_VENUE_MAPS_URL · EVENT_HOSTS_LEFT · EVENT_HOSTS_RIGHT · EVENT_COVER_IMAGE
#           EVENT_ACCENT_COLOR · EVENT_THEME
# Features: FEATURE_PHONE_FIELD
# ─────────────────────────────────────────────────────────────────────────────

FROM oven/bun:1.2-alpine AS base
WORKDIR /app

FROM base AS deps
COPY package.json bun.lock ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/web/package.json ./packages/web/
RUN bun install --frozen-lockfile

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/packages/web/node_modules ./packages/web/node_modules
COPY packages/shared ./packages/shared
COPY packages/web ./packages/web
COPY tsconfig.base.json ./

ENV NEXT_TELEMETRY_DISABLED=1

# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so they
# must arrive as build args (Dokploy → Service → Build → Build Args), not just
# runtime env. Without these, the browser would see `undefined` for the API/site
# URLs. Defaults keep local `docker compose build` working out of the box.
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL

RUN cd packages/web && bun run build

# Next.js standalone server.js targets Node, and the oven/bun image ships no
# `node` binary — so the runner uses a Node base image to execute server.js.
FROM node:22-alpine AS runner
WORKDIR /app
RUN addgroup --system --gid 1001 pixfete && \
    adduser --system --uid 1001 pixfete

COPY --from=builder --chown=pixfete:pixfete /app/packages/web/.next/standalone ./
COPY --from=builder --chown=pixfete:pixfete /app/packages/web/.next/static ./packages/web/.next/static
COPY --from=builder --chown=pixfete:pixfete /app/packages/web/public ./packages/web/public

USER pixfete
EXPOSE 3000
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "packages/web/server.js"]

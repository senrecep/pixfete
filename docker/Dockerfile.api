FROM oven/bun:1.2-alpine AS base
WORKDIR /app

FROM base AS deps
# All workspace manifests must be present or `--frozen-lockfile` sees the
# lockfile's workspace graph as "changed" and aborts.
COPY package.json bun.lock ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/storage/package.json ./packages/storage/
COPY packages/api/package.json ./packages/api/
COPY packages/web/package.json ./packages/web/
RUN bun install --frozen-lockfile --ignore-scripts

FROM base AS builder
# Bun hoists all deps (and the @pixfete/* workspace symlinks) into the root
# node_modules, so only that one tree needs to come across from deps.
COPY --from=deps /app/node_modules ./node_modules
COPY packages/shared ./packages/shared
COPY packages/storage ./packages/storage
COPY packages/api ./packages/api
COPY tsconfig.base.json ./

FROM base AS runner
# ffmpeg (+ ffprobe) powers background video transcoding (HEVC/.mov -> H.264 mp4).
RUN apk add --no-cache ffmpeg
RUN addgroup --system --gid 1001 pixfete && \
    adduser --system --uid 1001 pixfete
RUN mkdir -p /app/data /app/uploads && chown -R pixfete:pixfete /app

COPY --from=builder --chown=pixfete:pixfete /app/node_modules ./node_modules
COPY --from=builder --chown=pixfete:pixfete /app/packages/shared ./packages/shared
COPY --from=builder --chown=pixfete:pixfete /app/packages/storage ./packages/storage
COPY --from=builder --chown=pixfete:pixfete /app/packages/api ./packages/api
COPY --from=builder --chown=pixfete:pixfete /app/tsconfig.base.json ./

USER pixfete
EXPOSE 3001

CMD ["bun", "run", "packages/api/src/index.ts"]
